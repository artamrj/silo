{
    "name": "silo",
    "version": "0.1.0",
    "type": "module",
    "engines": {
        "node": ">=22.18.0 <23"
    },
    "scripts": {
        "fmt": "eslint \"**/*.{ts,vue}\" --fix",
        "lint": "eslint \"**/*.{ts,vue}\"",
        "check-ts": "tsc --noEmit",
        "start": "tsx ./backend/index.ts",
        "dev": "concurrently -k -r \"wait-on tcp:5000 && npm run dev:backend \" \"npm run dev:frontend\"",
        "dev:backend": "cross-env NODE_ENV=development tsx watch --inspect ./backend/index.ts",
        "dev:frontend": "cross-env NODE_ENV=development vite --host --config ./frontend/vite.config.ts",
        "build:frontend": "vite build --config ./frontend/vite.config.ts",
        "build:docker": "docker build -t ghcr.io/artamrj/silo:latest -f ./docker/Dockerfile .",
        "start-docker": "docker run --rm -p 5001:5001 --name silo ghcr.io/artamrj/silo:latest",
        "reset-password": "tsx ./extra/reset-password.ts"
    },
    "dependencies": {
        "@homebridge/node-pty-prebuilt-multiarch": "0.13.1",
        "@inventage/envsubst": "^0.17.0",
        "bcryptjs": "~3.0.3",
        "check-password-strength": "~3.0.0",
        "command-exists": "~1.2.9",
        "composerize": "~1.7.6",
        "croner": "~10.0.1",
        "dayjs": "~1.11.21",
        "dotenv": "~17.4.2",
        "express": "~5.2.1",
        "express-static-gzip": "~3.0.1",
        "http-graceful-shutdown": "~4.0.0",
        "jsonwebtoken": "~9.0.3",
        "jwt-decode": "~4.0.0",
        "knex": "~3.3.0",
        "limiter-es6-compat": "~2.1.2",
        "mysql2": "~3.23.1",
        "promisify-child-process": "~5.0.1",
        "redbean-node": "~0.3.3",
        "semver": "^7.8.5",
        "socket.io": "~4.8.3",
        "socket.io-client": "~4.8.3",
        "sqlite3": "~6.0.1",
        "timezones-list": "~3.1.0",
        "ts-command-line-args": "~2.5.1",
        "tsx": "~4.23.1",
        "type-fest": "~5.8.0",
        "yaml": "~2.9.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@codemirror/lang-python": "^6.2.1",
        "@codemirror/lang-yaml": "^6.1.3",
        "@fontsource/jetbrains-mono": "^5.3.0",
        "@fortawesome/fontawesome-svg-core": "7.3.1",
        "@fortawesome/free-regular-svg-icons": "7.3.1",
        "@fortawesome/free-solid-svg-icons": "7.3.1",
        "@fortawesome/vue-fontawesome": "3.3.3",
        "@types/bootstrap": "~5.2.11",
        "@types/command-exists": "~1.2.3",
        "@types/express": "~5.0.6",
        "@types/jsonwebtoken": "~9.0.10",
        "@types/semver": "^7.7.1",
        "@typescript-eslint/eslint-plugin": "~8.65.0",
        "@typescript-eslint/parser": "~8.65.0",
        "@vitejs/plugin-vue": "~6.0.8",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/xterm": "^6.0.0",
        "bootstrap": "5.3.8",
        "bootstrap-vue-next": "~0.45.8",
        "codemirror": "^6.0.2",
        "concurrently": "^10.0.3",
        "cross-env": "~10.1.0",
        "eslint": "~10.7.0",
        "eslint-plugin-jsdoc": "~63.2.0",
        "eslint-plugin-vue": "~10.10.0",
        "globals": "^17.7.0",
        "sass": "~1.101.3",
        "thememirror": "^2.0.1",
        "typescript": "~6.0.3",
        "unplugin-vue-components": "~32.1.0",
        "vite": "~8.1.5",
        "vite-plugin-compression": "~0.5.1",
        "vue": "~3.5.40",
        "vue-codemirror6": "^1.6.1",
        "vue-eslint-parser": "~10.4.1",
        "vue-i18n": "~11.4.7",
        "vue-qrcode": "~2.2.2",
        "vue-router": "~5.2.0",
        "vue-toastification": "2.0.0-rc.5",
        "wait-on": "^9.1.0"
    },
    "overrides": {
        "glob": "13.0.6",
        "lodash": "4.18.1",
        "shell-quote": "1.10.0"
    }
}
