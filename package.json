{
    "name": "silo",
    "version": "0.1.0",
    "type": "module",
    "engines": {
        "node": ">=24.18.0 <25"
    },
    "scripts": {
        "fmt": "eslint \"**/*.{ts,vue}\" --fix",
        "lint": "eslint \"**/*.{ts,vue}\"",
        "check-ts": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "start": "node ./dist/server/index.js",
        "dev": "concurrently -k -r \"wait-on tcp:5173 && npm run dev:server\" \"npm run dev:client\"",
        "dev:server": "cross-env NODE_ENV=development tsx watch --inspect ./src/server/index.ts",
        "dev:client": "cross-env NODE_ENV=development vite --host --config ./src/client/vite.config.ts",
        "build": "npm run build:server && npm run build:client",
        "build:server": "node ./scripts/build-server.mjs",
        "build:client": "vite build --config ./src/client/vite.config.ts",
        "check-size": "node ./scripts/check-bundle-size.mjs",
        "build:docker": "docker build -t ghcr.io/artamrj/silo:latest -f ./docker/Dockerfile .",
        "start-docker": "docker run --rm -p 5001:5001 --name silo ghcr.io/artamrj/silo:latest",
        "reset-password": "node ./dist/scripts/reset-password.js"
    },
    "dependencies": {
        "@homebridge/node-pty-prebuilt-multiarch": "0.13.1",
        "bcryptjs": "~3.0.3",
        "command-exists": "~1.2.9",
        "composerize": "~1.7.6",
        "dotenv": "~17.4.2",
        "express": "~5.2.1",
        "http-graceful-shutdown": "~4.0.0",
        "jsonwebtoken": "~9.0.3",
        "limiter-es6-compat": "~2.1.2",
        "pino": "^9.14.0",
        "prom-client": "^15.1.3",
        "socket.io": "~4.8.3",
        "socket.io-client": "~4.8.3",
        "yaml": "~2.9.0",
        "zod": "~4.6.7"
    },
    "devDependencies": {
        "@codemirror/lang-python": "^6.2.1",
        "@codemirror/lang-yaml": "^6.1.3",
        "@eslint/js": "^10.0.1",
        "@lucide/vue": "^1.59.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/command-exists": "~1.2.3",
        "@types/express": "~5.0.6",
        "@types/jsonwebtoken": "~9.0.10",
        "@typescript-eslint/eslint-plugin": "~8.65.0",
        "@typescript-eslint/parser": "~8.65.0",
        "@vitejs/plugin-vue": "~6.0.8",
        "@vueuse/core": "^14.4.0",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/xterm": "^6.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^10.0.3",
        "cross-env": "~10.1.0",
        "esbuild": "0.28.1",
        "eslint": "~10.7.0",
        "eslint-plugin-jsdoc": "~63.2.0",
        "eslint-plugin-vue": "~10.10.0",
        "globals": "^17.7.0",
        "reka-ui": "^2.11.0",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "tsx": "~4.23.1",
        "tw-animate-css": "^1.4.0",
        "typescript": "~6.0.3",
        "vite": "~8.1.5",
        "vitest": "^4.1.12",
        "vue": "~3.5.40",
        "vue-codemirror6": "^1.6.1",
        "vue-eslint-parser": "~10.4.1",
        "vue-i18n": "~11.4.7",
        "vue-router": "~5.2.0",
        "vue-sonner": "^2.0.9",
        "wait-on": "^9.1.0"
    },
    "overrides": {
        "glob": "13.0.6",
        "lodash": "4.18.1"
    },
    "allowScripts": {
        "@homebridge/node-pty-prebuilt-multiarch@0.13.1": true,
        "core-js@2.6.12": true,
        "esbuild@0.28.1": true,
        "fsevents@2.3.3": true,
        "vue-demi@0.14.10": true
    }
}
