{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "allowJs": true,
        "checkJs": false,
        "lib": [ "ESNext", "DOM", "DOM.Iterable" ],
        "types": [ "vite/client" ],
        "jsx": "preserve",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "useDefineForClassFields": true
    },
    "include": [
        "src/client/**/*.ts",
        "src/client/**/*.vue",
        "src/shared/**/*",
        "src/client/src/vite-env.d.ts"
    ]
}
