{
    "compilerOptions": {
        "module": "ESNext",
        "target": "ESNext",
        "strict": true,
        "moduleResolution": "bundler",
        "skipLibCheck": true,
        "paths": {
            "@/*": [
                "./src/client/src/*"
            ]
        }
    },
    "include": [
        "src/server/**/*",
        "src/shared/**/*",
        "scripts/**/*"
    ]
}
