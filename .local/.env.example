# Copy this file to .local/.env for local development.
SILO_DATA_DIR=./.local/data
SILO_STACKS_DIR=./.local/stacks
SILO_PORT=5001
SILO_LOG_LEVEL=debug

# Disabled by default. Set true only when a local shell console is required.
SILO_ENABLE_CONSOLE=false

# Skip authentication. Already enabled automatically when NODE_ENV=development
# (npm run dev). Set true only to force it for a production-style local build.
# Dev-only: never enable in production. Seeds admin/admin123 when the user table is empty.
# SILO_DEV_NO_AUTH=true